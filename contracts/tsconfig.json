{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // The guard covers production code; the repo-wide tsconfig still typechecks
  // the contract tests (which may legitimately reach into a feature for setup).
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/*.test.ts"]
}
